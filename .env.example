# Mkety Platform environment variables

# Application
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=Mkety
# NODE_ENV=development

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Mkety Auth — ZITADEL is the initial provider adapter; Mkety owns the auth boundary.
# MKETY_AUTH_PROVIDER=zitadel
# MKETY_AUTH_ISSUER=https://<instance>.zitadel.cloud
# MKETY_AUTH_CLIENT_ID=
# MKETY_AUTH_CLIENT_SECRET=
# MKETY_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# MKETY_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# MKETY_AUTH_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long

# Cloudflare handoff/deployment configuration.
# Base Worker name is defined in wrangler.jsonc as mkety-platform.
# The named preview environment deploys separately as mkety-platform-preview.
# Keep secrets in GitHub/Cloudflare secret storage; do not commit values here.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BUILD_TOKEN_UUID=  # only for Workers Builds API automation

# Mkety AI Core (disabled by default; do not enter fake credentials)
# ENABLE_AI_FEATURES=false
# MKETY_AI_PROVIDER=openai
# MKETY_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Optional OpenAI-compatible providers. Only configure the provider you actually use.
# MKETY_AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# MKETY_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MKETY_AI_PROVIDER=custom
# MKETY_AI_API_KEY=
# MKETY_AI_BASE_URL=https://your-compatible-endpoint.example.com/v1

# Public Mkety AI (isolated from Platform/tenant AI)
# MKETY_PUBLIC_AI_ENABLED=false
# MKETY_PUBLIC_AI_VISITOR_SECRET=
# MKETY_PUBLIC_AI_PRIMARY_PROVIDER=openai
# MKETY_PUBLIC_AI_FALLBACK_PROVIDERS=
# MKETY_PUBLIC_OPENAI_API_KEY=
# MKETY_PUBLIC_GEMINI_API_KEY=
# MKETY_PUBLIC_AZURE_OPENAI_API_KEY=
# MKETY_PUBLIC_AZURE_OPENAI_ENDPOINT=
# MKETY_PUBLIC_AZURE_OPENAI_DEPLOYMENT=
# MKETY_PUBLIC_VERTEX_PROJECT_ID=
# MKETY_PUBLIC_VERTEX_LOCATION=global
# MKETY_PUBLIC_VERTEX_ACCESS_TOKEN=
# MKETY_PUBLIC_CLOUDFLARE_ACCOUNT_ID=
# MKETY_PUBLIC_CLOUDFLARE_AI_API_TOKEN=
# MKETY_PUBLIC_BEDROCK_ACCESS_KEY_ID=
# MKETY_PUBLIC_BEDROCK_SECRET_ACCESS_KEY=
# MKETY_PUBLIC_BEDROCK_SESSION_TOKEN=
# MKETY_PUBLIC_BEDROCK_REGION=us-east-1

# Enterprise checkout compatibility bridge.
# Reuse the current production payment credentials during the public-site migration.
# Keep these server-side only. Browser success/return is never payment proof.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# SELAR_ENTERPRISE_CHECKOUT_URL=https://selar.com/your-enterprise-product

# Temporary testing only. Set ENABLE_TEST_LOGIN=true on a private non-production
# deployment when identity-provider testing is intentionally bypassed.
# Keep false for production.
# ENABLE_TEST_LOGIN=true

# Optional storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1

# Optional observability
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# CI/build
# SKIP_ENV_VALIDATION=true
