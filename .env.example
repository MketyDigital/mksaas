# Mkety Platform environment variables

# Application
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=Mkety
# NODE_ENV=development

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Authentication (current template-compatible auth; ZITADEL migration is a later production phase)
# AUTH_SECRET=generate-a-random-secret-at-least-32-characters-long
# AUTH_URL=https://your-domain.example.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_ISSUER=

# Mkety AI Core (disabled by default; do not enter fake credentials)
# ENABLE_AI_FEATURES=false
# MKETY_AI_PROVIDER=openai
# MKETY_AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Optional OpenAI-compatible providers. Only configure the provider you actually use.
# MKETY_AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# MKETY_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MKETY_AI_PROVIDER=custom
# MKETY_AI_API_KEY=
# MKETY_AI_BASE_URL=https://your-compatible-endpoint.example.com/v1

# Temporary testing only. Set ENABLE_TEST_LOGIN=true on a private preview/staging
# deployment when production identity/email verification is not configured.
# Keep false for production.
# ENABLE_TEST_LOGIN=true

# Optional storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1

# Optional observability
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# CI/build
# SKIP_ENV_VALIDATION=true
