# Next.js SaaS AI Template environment variables

# Application
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=Next.js SaaS AI Template
# NODE_ENV=development

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Authentication
# AUTH_SECRET=generate-a-random-secret-at-least-32-characters-long
# AUTH_URL=https://your-domain.example.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_ISSUER=https://your-tenant.auth0.com

# AI (disabled by default)
# OPENAI_API_KEY=sk-...
# ENABLE_AI_FEATURES=true

# Temporary testing only. Set ENABLE_TEST_LOGIN=true on a private preview/staging
# deployment when Auth0/email OTP is not configured. Keep false for production.
# ENABLE_TEST_LOGIN=true

# Optional storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1

# Optional observability
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# CI/build
# SKIP_ENV_VALIDATION=true
