{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkety-mail-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true},
  "r2_buckets": [
    {"binding":"MAIL_STORAGE","bucket_name":"mkety-mail-storage"}
  ]
}
