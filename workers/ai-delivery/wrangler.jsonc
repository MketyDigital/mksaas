{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkety-ai-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "consumers": [
      {
        "queue": "mkety-ai-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 12,
        "dead_letter_queue": "mkety-ai-delivery-dead"
      }
    ]
  }
}
