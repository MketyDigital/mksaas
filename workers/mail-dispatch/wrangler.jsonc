{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkety-mail-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "mkety-mail-send",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "mkety-mail-dead"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_STORAGE",
      "bucket_name": "mkety-mail-storage"
    }
  ]
}
