{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkety-mail-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true},
  "queues": {
    "consumers": [
      {
        "queue": "mkety-mail-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "mkety-mail-events-dead"
      }
    ]
  }
}
