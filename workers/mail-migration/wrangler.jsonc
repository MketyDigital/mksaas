{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mkety-mail-migration",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "queues": {
    "producers": [{ "binding": "MAIL_MIGRATION_QUEUE", "queue": "mkety-mail-migrations" }],
    "consumers": [
      {
        "queue": "mkety-mail-migrations",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "mkety-mail-migrations-dead",
      },
    ],
  },
}
