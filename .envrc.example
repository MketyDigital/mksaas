#!/usr/bin/env bash

# ============================================================================
# Mkety - Development Environment Configuration
# ============================================================================
# USAGE:
#   direnv allow
#
# If a .env.local file exists, it will be loaded and can override these
# defaults. Keep real secrets in .env.local or approved secret storage.
# ============================================================================

# Application
export NODE_ENV="${NODE_ENV:-development}"
export NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL:-http://localhost:3000}"
export NEXT_PUBLIC_APP_NAME="${NEXT_PUBLIC_APP_NAME:-Mkety}"

# Database
export DATABASE_URL="${DATABASE_URL:-postgresql://saas_template:saas_template@localhost:5432/saas_template_dev}"

# Mkety Auth
# ZITADEL is the current OIDC provider adapter. Mkety owns application sessions
# and authorization. Do not restore AUTH0_*, NEXTAUTH_*, or AUTH_SECRET paths.
export MKETY_AUTH_PROVIDER="${MKETY_AUTH_PROVIDER:-zitadel}"
export MKETY_AUTH_ISSUER="${MKETY_AUTH_ISSUER:-}"
export MKETY_AUTH_CLIENT_ID="${MKETY_AUTH_CLIENT_ID:-}"
export MKETY_AUTH_CLIENT_SECRET="${MKETY_AUTH_CLIENT_SECRET:-}"
export MKETY_AUTH_REDIRECT_URI="${MKETY_AUTH_REDIRECT_URI:-http://localhost:3000/api/auth/callback}"
export MKETY_AUTH_POST_LOGOUT_REDIRECT_URI="${MKETY_AUTH_POST_LOGOUT_REDIRECT_URI:-http://localhost:3000/login}"
export MKETY_AUTH_SESSION_SECRET="${MKETY_AUTH_SESSION_SECRET:-}"

# AI / LLM
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
export ENABLE_AI_FEATURES="${ENABLE_AI_FEATURES:-false}"

# AWS / Storage (optional)
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_S3_BUCKET="${AWS_S3_BUCKET:-}"
export S3_ENDPOINT="${S3_ENDPOINT:-}"
export S3_PUBLIC_ENDPOINT="${S3_PUBLIC_ENDPOINT:-}"

# Observability (optional)
export SENTRY_DSN="${SENTRY_DSN:-}"
export NEXT_PUBLIC_SENTRY_DSN="${NEXT_PUBLIC_SENTRY_DSN:-}"

# Load local overrides
if [[ -f .env.local ]]; then
  echo "Loading environment overrides from .env.local..."
  set -a
  source .env.local
  set +a
elif [[ -f .env ]]; then
  echo "Loading environment overrides from .env..."
  set -a
  source .env
  set +a
else
  echo "Tip: Create .env.local from .env.example to customize configuration."
fi

export npm_config_engine_strict=true

if [[ -n "${REMOTE_CONTAINERS}" ]] || [[ -n "${CODESPACES}" ]]; then
  export DATABASE_URL="${DATABASE_URL:-postgresql://saas_template:saas_template@db:5432/saas_template_dev}"
fi

if ! command -v pnpm > /dev/null 2>&1; then
  echo "pnpm not found. Install a version compatible with package.json."
fi

echo ""
echo "Mkety - Available Commands:"
echo "  pnpm dev                     - Start development server"
echo "  pnpm build                   - Build Cloudflare deployment artifact"
echo "  pnpm lint                    - Run ESLint"
echo "  pnpm type-check              - Run TypeScript check"
echo "  pnpm test                    - Run tests"
echo "  pnpm db:generate             - Generate Drizzle migrations"
echo "  pnpm db:migrate              - Run Drizzle migrations"
echo "  pnpm db:migrate:mkety-content - Apply Mkety content/app bootstrap migrations"
echo "  pnpm db:smoke:mkety-content  - Smoke Mkety content database"
echo ""
echo "Documentation: see AGENTS.md and docs/."
