{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mksaas",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
