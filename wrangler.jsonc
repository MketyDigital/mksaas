{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mksaas",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  }
}
