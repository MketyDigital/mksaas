{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkety-platform",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "images": {
    "binding": "IMAGES",
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "keep_vars": true,
      "observability": {
        "enabled": true,
      },
      "cache": {
        "enabled": true,
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "images": {
        "binding": "IMAGES",
      },
    },
  },
}
