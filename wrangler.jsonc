{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkety-platform",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
